# Localhost-facing overrides for docker-compose.local.yml.
# Copy this file to .env.local and adjust only what you need.

BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3000/github/auth/callback
GITHUB_REDIRECT_URI=http://localhost:3000/github/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/google/auth/callback

COOKIE_DOMAIN=
COOKIE_SECURE=false

SOLITUD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
SOLITUD_TRUSTED_HOSTS=localhost,127.0.0.1,api,ws

SOLITUD_API_BASE_URL=http://api:8000
SOLITUD_SOCKET_SERVER_HOST=http://localhost:8001
SOLITUD_SOCKET_SERVER_INTERNAL_HOST=http://ws:8001
SOLITUD_PREVIEW_ORIGIN=http://localhost:3000
